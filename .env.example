# Buddy.ai v2.1 Configuration
# Copy this to .env and fill in your keys:  cp .env.example .env

# Required: Google Gemini API Key
GEMINI_API_KEY=your-gemini-key-here
# Alternative: GOOGLE_API_KEY=your-key-here

# Optional: Model selection (default: gemini-2.0-flash)
# Choices: gemini-3.5-flash-lite (Recommended), gemini-3.6-flash, gemini-3.1-pro-preview, qwen2.5:3b (Offline)
MODEL_NAME=gemini-2.0-flash

# Offline mode (Ollama qwen2.5:3b) — used for --offline and option 4
OFFLINE_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: Custom OpenAI-compatible base URL
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: Max tokens for responses
MAX_TOKENS=4096

# Optional: Temperature (0.0-2.0)
TEMPERATURE=0.7

# Optional: Memory file location
MEMORY_DIR=./data/memory

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
