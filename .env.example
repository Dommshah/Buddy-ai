# Kaka.ai Configuration
# Copy this to .env and fill in your API keys

# ── Provider selection ─────────────────────────────────────────────────
# Options: openrouter | openai | gemini
# If unset, auto-detected from whichever API key below is present.
# PROVIDER=openrouter

# ── Provider API keys (set at least one) ───────────────────────────────
# OpenRouter — 400+ models from every major lab through one key
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Google Gemini (direct)
GEMINI_API_KEY=your-gemini-key-here

# OpenAI (direct)
OPENAI_API_KEY=sk-your-openai-key-here

# Extra keys for custom sub-agents / multi-agent scripts
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GROQ_API_KEY=gsk_your-groq-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
MISTRAL_API_KEY=your-mistral-key-here
XAI_API_KEY=your-xai-key-here

# ── Model selection ────────────────────────────────────────────────────
# OpenRouter examples: z-ai/glm-5.2:free, google/gemma-4-31b-it:free,
#   nvidia/nemotron-3-ultra-550b-a55b:free, anthropic/claude-sonnet-4.5,
#   openai/gpt-4o-mini, deepseek/deepseek-chat-v3.1, meta-llama/llama-3.3-70b-instruct
MODEL_NAME=z-ai/glm-5.2:free

# Custom API base URL (auto-set for known providers; override if needed)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── General settings ───────────────────────────────────────────────────
MAX_TOKENS=4096
TEMPERATURE=0.7
MEMORY_DIR=./data/memory
LOG_LEVEL=INFO
